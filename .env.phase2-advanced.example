# AlphaMind 第二阶段（进阶调优与图谱接入版）环境变量示例
#
# 用法：复制为 .env.phase2-advanced，填入本地模型服务地址和密钥后启动：
#   docker compose --env-file .env.phase2-advanced `
#     -f docker-compose.yml -f docker-compose.phase2-advanced.yml `
#     --profile qdrant --profile neo4j --profile minio up -d
#
# 第二阶段验收：金融 PDF/简单表格解析、金融 chunking、Graph RAG 基础图谱、
# 混合检索 + Rerank + 引用问答。复杂跨页表格和准生产压测属于后续阶段。

# ========== 基础 ==========
WEKNORA_VERSION=latest
GIN_MODE=release
LOG_LEVEL=info
TZ=Asia/Shanghai
WEKNORA_LANGUAGE=zh-CN
DISABLE_REGISTRATION=false
WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

FRONTEND_PORT=8088
APP_HOST=app
APP_PORT=8080
APP_BACKEND_PORT=8080
APP_SCHEME=http
APP_EXTERNAL_URL=http://localhost:8088
WEKNORA_BASE_URL=http://localhost:8080
WEKNORA_API_KEY=

# PDF/年报/招股书体积可能明显大于第一阶段样本。
MAX_FILE_SIZE_MB=300
WEKNORA_DOCUMENT_PROCESS_TIMEOUT=2h
WEKNORA_DOCREADER_CALL_TIMEOUT=30m

# ========== 数据库 / 队列 ==========
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=alphamind_phase2_postgres_change_me
DB_NAME=WeKnoraPhase2

STREAM_MANAGER_TYPE=redis
REDIS_PASSWORD=alphamind_phase2_redis_change_me
REDIS_DB=0
REDIS_PREFIX=alphamind:phase2:stream:

TENANT_AES_KEY=alphamind-phase2-tenant-key-0001
SYSTEM_AES_KEY=alphamind-phase2-system-key-0001
JWT_SECRET=alphamind-phase2-jwt-secret-change-me

# ========== 检索 / 向量库 ==========
RETRIEVE_DRIVER=qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6334
QDRANT_REST_PORT=6333
QDRANT_COLLECTION=alphamind_phase2_advanced_embeddings
QDRANT_USE_TLS=false
QDRANT_API_KEY=
CONCURRENCY_POOL_SIZE=2
WEKNORA_ASYNQ_CONCURRENCY=4

# ========== 文件存储 ==========
STORAGE_TYPE=minio
STORAGE_ALLOW_LIST=minio,local
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY_ID=alphamind_phase2_minio
MINIO_SECRET_ACCESS_KEY=alphamind_phase2_minio_change_me
MINIO_BUCKET_NAME=alphamind-phase2

# ========== Graph RAG / Neo4j ==========
ENABLE_GRAPH_RAG=true
NEO4J_ENABLE=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_HTTP_URL=http://localhost:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=alphamind_phase2_neo4j_change_me
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=1G
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G

# 第二阶段不把 Langfuse 作为硬验收项；需要观测时再填 key 并加 --profile langfuse。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_URL=http://localhost:3000

# ========== 文档解析 ==========
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc
DOCREADER_ODL_MAX_WORKERS=2
DOCREADER_MARKITDOWN_MAX_WORKERS=2
DOCREADER_PDF_RENDER_MAX_WORKERS=2
DOCREADER_PDF_RENDER_PARALLELISM=2
DOCREADER_PDF_RENDER_DPI=200
DOCREADER_PDF_FORCE_SCANNED=false
DOCREADER_ODL_HYBRID=off

# ========== 本地模型服务 ==========
# 报价单二阶段仍沿用本地 Qwen 35B、Embedding、Rerank API。
LLM_MODEL_NAME=qwen-35b-local
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=local-no-auth
LLM_PROVIDER=openai

EMBEDDING_MODEL_NAME=qwen3-embedding-local
EMBEDDING_BASE_URL=http://host.docker.internal:8001/v1
EMBEDDING_API_KEY=local-no-auth
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSION=1024
EMBEDDING_TRUNCATE_PROMPT_TOKENS=0

RERANK_MODEL_NAME=qwen3-reranker-local
RERANK_BASE_URL=http://host.docker.internal:8002
RERANK_API_KEY=local-no-auth
RERANK_PROVIDER=generic

# 可选：本地 Ollama，不作为第二阶段正式验收默认依赖。
OLLAMA_BASE_URL=http://host.docker.internal:11434

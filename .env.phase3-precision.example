# AlphaMind 第三阶段（终极高精版）环境变量示例
# 建议先复制现有 .env.phase2-advanced 为 .env.phase3-precision，以保留 AES key/API key，
# 再按本文件增加或修改 Phase3 项。不要提交真实密钥。
PHASE3_ENV_FILE=.env.phase3-precision
WEKNORA_VERSION=latest
GIN_MODE=release
LOG_LEVEL=info
TZ=Asia/Shanghai
WEKNORA_LANGUAGE=zh-CN
FRONTEND_PORT=8088
APP_PORT=8080
APP_BACKEND_PORT=8080
APP_HOST=app
APP_SCHEME=http
APP_EXTERNAL_URL=http://localhost:8088
WEKNORA_BASE_URL=http://localhost:8080
WEKNORA_API_KEY=
MAX_FILE_SIZE_MB=500
WEKNORA_DOCUMENT_PROCESS_TIMEOUT=4h
WEKNORA_DOCREADER_CALL_TIMEOUT=60m
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=WeKnoraPhase3
STREAM_MANAGER_TYPE=redis
REDIS_PASSWORD=change_me
REDIS_DB=0
REDIS_PREFIX=alphamind:phase3:stream:
TENANT_AES_KEY=copy_from_existing_phase2_env
SYSTEM_AES_KEY=copy_from_existing_phase2_env
JWT_SECRET=change_me
RETRIEVE_DRIVER=qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6334
QDRANT_REST_PORT=6333
QDRANT_COLLECTION=alphamind_phase3_precision_embeddings
QDRANT_USE_TLS=false
QDRANT_API_KEY=
CONCURRENCY_POOL_SIZE=1
BATCH_EMBED_SIZE=5
WEKNORA_ASYNQ_CONCURRENCY=8
STORAGE_TYPE=minio
STORAGE_ALLOW_LIST=minio,local
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY_ID=alphamind_phase3_minio
MINIO_SECRET_ACCESS_KEY=change_me
MINIO_BUCKET_NAME=alphamind-phase3
ENABLE_GRAPH_RAG=true
NEO4J_ENABLE=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_HTTP_URL=http://localhost:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=2G
NEO4J_HEAP_MAX=4G
NEO4J_PAGECACHE=2G
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_URL=http://localhost:3000
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc
DOCREADER_ODL_MAX_WORKERS=2
DOCREADER_MARKITDOWN_MAX_WORKERS=2
DOCREADER_PDF_RENDER_MAX_WORKERS=2
DOCREADER_PDF_RENDER_PARALLELISM=4
DOCREADER_PDF_RENDER_DPI=240
DOCREADER_PDF_RENDER_MAX_EDGE=2600
DOCREADER_PDF_FORCE_SCANNED=false
DOCREADER_ODL_HYBRID=on
DOCREADER_ODL_HYBRID_MODE=auto
DOCREADER_ODL_HYBRID_FALLBACK=true
DOCREADER_ODL_HYBRID_URL=
PHASE3_PDF_ENGINE=pymupdf-layout
PHASE3_PDF_MIN_NUMERIC_PRESERVATION=0.98
# 客户目标机默认用 vLLM 启动 qwen3-14b，并通过 OpenAI-compatible /v1 API 暴露。
# vLLM 推荐使用 --served-model-name qwen3-14b；若客户实际服务名不同，LLM_MODEL_NAME 与
# PHASE3_DIRECT_CHAT_MODEL 必须同步改成 /v1/models 返回的 id。
LLM_MODEL_NAME=qwen3-14b
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=local-no-auth
LLM_PROVIDER=openai
SSRF_WHITELIST=host.docker.internal
PHASE3_DIRECT_CHAT_RUNTIME=vllm
PHASE3_DISABLE_THINKING=true
PHASE3_DIRECT_CHAT_URL=http://localhost:8000/v1
PHASE3_DIRECT_CHAT_MODEL=qwen3-14b
PHASE3_EMBEDDING_UNLOAD_URL=http://localhost:8010
EMBEDDING_MODEL_NAME=qwen3-embedding-4b-local
EMBEDDING_BASE_URL=http://host.docker.internal:8010/v1
EMBEDDING_API_KEY=local-no-auth
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSION=1024
EMBEDDING_TRUNCATE_PROMPT_TOKENS=0
RERANK_MODEL_NAME=qwen3-reranker-0.6b-local
RERANK_BASE_URL=http://host.docker.internal:8010
RERANK_API_KEY=local-no-auth
RERANK_PROVIDER=generic
